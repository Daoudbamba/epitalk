# Backend configuration for local development (cargo run)

DATABASE_URL=postgres://epitalk:Epitalk94!@localhost:5433/epitalk
MONGO_URL=mongodb://localhost:27017/epitalk_messages

JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=168

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=*

# ── Logging ─────────────────────────────────────────────────────────────────
RUST_LOG=epitalk_backend=info,tower_http=info

# ── Migrations ──────────────────────────────────────────────────────────────
# Run SQL migrations automatically at startup (default: false).
RUN_MIGRATIONS=true

# ── Docker Compose helpers (used by postgres container, NOT by Rust) ────────
POSTGRES_USER=epitalk
POSTGRES_PASSWORD=Epitalk94!
POSTGRES_DB=epitalk
