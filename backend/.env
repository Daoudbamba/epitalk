# =============================================================================
# EpiTalk Backend — Local Development
# =============================================================================
# Generated from .env.example — see that file for documentation.
# =============================================================================

# ── PostgreSQL [REQUIRED] ────────────────────────────────────────────────────
DATABASE_URL=postgres://epitalk:Epitalk94!@localhost:5433/epitalk

# ── MongoDB [REQUIRED] ──────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/epitalk
MONGO_URL=mongodb://localhost:27017

# ── JWT [REQUIRED] ──────────────────────────────────────────────────────────
JWT_SECRET=local-dev-secret-not-for-production-change-me-32ch

# Token lifetime in hours
JWT_EXPIRES_IN=168

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=*

# ── Logging ─────────────────────────────────────────────────────────────────
RUST_LOG=epitalk_backend=debug,tower_http=debug

# ── Migrations ──────────────────────────────────────────────────────────────
# Run SQL migrations automatically at startup (default: false).
RUN_MIGRATIONS=true

# ── Docker Compose helpers (used by postgres container, NOT by Rust) ────────
POSTGRES_USER=epitalk
POSTGRES_PASSWORD=Epitalk94!
POSTGRES_DB=epitalk
