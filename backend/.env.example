# Environment variables for the backend

# Default: local development with Docker databases only
# - Postgres is exposed on localhost:5433
# - MongoDB is exposed on localhost:27017
DATABASE_URL=postgres://epitalk:Epitalk94!@localhost:5433/epitalk
MONGO_URL=mongodb://localhost:27017/epitalk_messages

JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=168
PORT=3000

# When running the backend INSIDE docker-compose, the backend service overrides
# DATABASE_URL and MONGO_URL to point to `postgres` and `mongo` on port 5432/27017.
